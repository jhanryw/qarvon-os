# Instância Supabase self-hosted do Qarvon OS (separada do ERP Santtorini).
# Preencher com os valores reais fornecidos posteriormente. Nunca commitar .env.local.

# URL pública da instância Supabase self-hosted.
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon/public — segura para uso no browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service role — SOMENTE server-side (bootstrap administrativo). Nunca expor com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Pepper usado para verificar o hash do token de integrações externas
# (ex.: LP pública) — nunca o token em si. Ver supabase/BOOTSTRAP.md para o
# procedimento de geração/rotação. SOMENTE server-side.
INTEGRATION_TOKEN_PEPPER=

# Chave de cifragem (pgcrypto pgp_sym_encrypt/decrypt) do access token da
# Meta Conversions API — nunca persistida no banco, só usada como parâmetro
# a cada chamada das RPCs upsert_meta_integration/get_meta_access_token.
# Gerar uma vez com `openssl rand -base64 32` e nunca trocar sem antes
# recriptografar os tokens já salvos (trocar a chave sem migrar os dados
# torna qualquer token já salvo indecifrável). SOMENTE server-side.
META_TOKEN_ENCRYPTION_KEY=
